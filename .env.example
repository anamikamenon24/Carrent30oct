# DriveEasy settings. Copy to .env.local and fill in. Never commit real values.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (local DriveEasy PostgreSQL instance on port 5433 now; a cloud Postgres URL later) ---
DATABASE_URL=postgres://driveeasy:<password>@localhost:5433/driveeasy_dev
TEST_DATABASE_URL=postgres://driveeasy:<password>@localhost:5433/driveeasy_test
# "pg" (node-postgres, local and long-lived servers) or "neon" (@neondatabase/serverless on Vercel Functions)
DATABASE_DRIVER=pg
DATABASE_POOL_MAX=10
# Migrations use a direct (non-pooled) connection. On Vercel the Neon integration sets DATABASE_URL_UNPOOLED;
# MIGRATION_DATABASE_URL overrides it. Leave empty locally (DATABASE_URL is used).
MIGRATION_DATABASE_URL=
# Set to 1 to skip migrations in a build (e.g. previews that share the production database).
SKIP_MIGRATIONS=

# --- Authentication (Better Auth, email + password) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- QR codes (signs QR payloads so they can't be forged) ---
QR_SIGNING_SECRET=

# --- Payments: "fake" (local stand-in) or "stripe" (cloud) ---
PAYMENTS_PROVIDER=fake
PAYMENTS_WEBHOOK_SECRET=
# Fake provider only
FAKE_PAYMENTS_WEBHOOK_URL=http://localhost:3000/api/webhooks/payments
FAKE_PAYMENTS_DUPLICATE_WEBHOOKS=false
# Stripe only (later). Test mode only: the app refuses anything but sk_test_ keys.
# PAYMENTS_WEBHOOK_SECRET is then the Stripe endpoint's whsec_... signing secret.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- File uploads: "local" (private folder) or "vercel-blob" (cloud, private blobs) ---
STORAGE_PROVIDER=local
UPLOADS_DIR=./storage/uploads
# Vercel Blob only (set by the Vercel Blob integration)
BLOB_READ_WRITE_TOKEN=

# --- Scheduled jobs: "local" (pnpm jobs:*) or "cloud-cron" (scheduler calls /api/cron/<job>) ---
SCHEDULER_PROVIDER=local
CRON_SECRET=

# --- Reservations ---
# How long an unpaid reservation holds the vehicle (minutes).
RESERVATION_HOLD_MINUTES=15
