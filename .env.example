# DriveEasy settings. Copy to .env.local and fill in. Never commit real values.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (local PostgreSQL now; a cloud Postgres URL later) ---
DATABASE_URL=postgres://driveeasy:<password>@localhost:5432/driveeasy_dev
TEST_DATABASE_URL=postgres://driveeasy:<password>@localhost:5432/driveeasy_test

# --- Authentication (Better Auth, email + password) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- QR codes (signs QR payloads so they can't be forged) ---
QR_SIGNING_SECRET=

# --- Payments: "fake" (local stand-in) or "stripe" (cloud) ---
PAYMENTS_PROVIDER=fake
PAYMENTS_WEBHOOK_SECRET=
# Fake provider only
FAKE_PAYMENTS_WEBHOOK_URL=http://localhost:3000/api/webhooks/payments
FAKE_PAYMENTS_DUPLICATE_WEBHOOKS=false
# Stripe only (later)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- File uploads: "local" (private folder) or "s3" (cloud, any S3-compatible service) ---
STORAGE_PROVIDER=local
UPLOADS_DIR=./storage/uploads
# S3 only (later)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Scheduled jobs: "local" (pnpm jobs:*) or "cloud-cron" (scheduler calls /api/cron/<job>) ---
SCHEDULER_PROVIDER=local
CRON_SECRET=
