{
  "name": "driveeasy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "tsx scripts/pg.mts start",
    "db:stop": "tsx scripts/pg.mts stop",
    "db:status": "tsx scripts/pg.mts status",
    "db:check": "tsx --env-file=.env.local scripts/check-db.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "tsx --env-file-if-exists=.env.local scripts/migrate.mts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.mts",
    "db:studio": "drizzle-kit studio",
    "job": "tsx --env-file=.env.local scripts/run-job.mts",
    "jobs:release-expired-holds": "tsx --env-file=.env.local scripts/run-job.mts release-expired-holds",
    "fake:webhook": "tsx --env-file=.env.local scripts/fake-webhook.mts",
    "admin:create": "tsx --env-file-if-exists=.env.local scripts/create-admin.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@vercel/blob": "2.8.2",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
